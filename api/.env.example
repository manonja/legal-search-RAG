# Required Configuration
# ------------------
# Google API key for Gemini model access
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API key for embeddings
OPENAI_API_KEY=your_openai_api_key_here

# RunPod Configuration
# ------------------
# API key for RunPod services
RUNPOD_API_KEY=API
# Endpoint ID for Mixtral model
RUNPOD_MIXTRAL_ENDPOINT_ID=endpoint_id
# Toggle to enable RunPod (true/false)
USE_RUNPOD=true

# Document Storage Configuration
# ------------------
# Base directory for storing all data
DATA_ROOT=./data

# Directory paths for document processing pipeline
CHROMA_DIR=${DATA_ROOT}/chroma # ChromaDB vector database
DATA_DIR=${DATA_ROOT}/data

# Collection Configuration
# ------------------
# Collection name in ChromaDB
COLLECTION_NAME=legal_docs

# OpenAI API Settings
# ------------------
OPENAI_MODEL=gpt-4-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Application Settings
# ------------------
LOG_LEVEL=INFO
DEBUG=false

# Authentication Settings
# ------------------
# API token for securing endpoints
API_TOKEN=your_api_token_here

# GCP project for deployment
GCP_PROJECT_ID=952577461734
