# API Configuration
# ------------------
# URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8080
# API token for authentication
NEXT_PUBLIC_API_TOKEN=your_api_token_here

# Sentry configuration
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn-value-here@organization.ingest.sentry.io/project-id

# Optional Configuration
# ------------------
# Enable debug mode (shows more console logs)
# NEXT_PUBLIC_DEBUG=true

# Customization
# ------------------
# Application title
# NEXT_PUBLIC_APP_TITLE="Legal Research Assistant"

# Theme configuration (light, dark, system)
# NEXT_PUBLIC_DEFAULT_THEME=system

# Optional: Application title and theme configuration
# NEXT_PUBLIC_APP_TITLE="Legal Research Assistant"
# NEXT_PUBLIC_THEME_PRIMARY_COLOR="#2563eb"

# Environment (development, staging, prod)
NEXT_PUBLIC_ENVIRONMENT=development

# Firebase Configuration (replace with your actual values in .env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
